# In development, requests to /auth, /experts, /services, etc. are proxied
# to the backend automatically (see vite.config.js), so you can leave this
# unset while running `npm run dev`.
#
# For a production build (`npm run build`) served separately from the
# backend, set this to your backend's full URL, e.g.:
# VITE_API_BASE=https://api.yourdomain.com
VITE_API_BASE=
